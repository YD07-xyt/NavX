          Autocompute Value Bounds:
            Max Value: 20
            Min Value: 0
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 245; 200
          Max Intensity: 0
          Min Color: 40; 120; 255
          Min Intensity: 0
          Name: Current registered scan
