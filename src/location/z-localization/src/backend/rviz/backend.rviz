Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /01 Environment1
        - /02 Localization1
        - /03 Maps1
        - /04 Pose Graph1
        - /05 Registration Debug1
      Splitter Ratio: 0.5
    Tree Height: 760
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.35
          Cell Size: 1
          Class: rviz_default_plugins/Grid
          Color: 120; 125; 132
          Enabled: true
          Line Style:
            Line Width: 0.029999999329447746
            Value: Lines
          Name: Metric grid
          Normal Cell Count: 0
          Offset:
            X: 0
            Y: 0
            Z: 0
          Plane: XY
          Plane Cell Count: 80
          Reference Frame: <Fixed Frame>
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Map origin axes
          Namespaces:
            map_axes: true
          Queue Size: 1
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 1
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /backend_node/map_axes
          Value: true
        - Class: rviz_default_plugins/TF
          Enabled: true
          Frame Timeout: 15
          Frames:
            All Enabled: true
          Marker Scale: 0.5
          Name: TF tree
          Show Arrows: true
          Show Axes: false
          Show Names: false
          Tree:
            {}
          Update Interval: 0
          Value: true
      Enabled: true
      Name: 01 Environment
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Axes Length: 1
          Axes Radius: 0.07999999821186066
          Class: rviz_default_plugins/PoseWithCovariance
          Color: 255; 190; 40
          Covariance:
            Orientation:
              Alpha: 0.35
              Color: 255; 170; 0
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.25
              Color: 255; 210; 80
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Head Length: 0.30000001192092896
          Head Radius: 0.10000000149011612
          Name: Body pose and covariance
          Shape: Axes
          Shaft Length: 0.699999988079071
          Shaft Radius: 0.05000000074505806
          Topic:
            Depth: 20
            Durability Policy: Volatile
            Filter size: 20
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /backend_node/localization_pose
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Localization state
          Namespaces:
            localization_status: true
          Queue Size: 1
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 1
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /backend_node/localization_status
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: UWB-derived body position
          Namespaces:
            uwb_position: true
          Queue Size: 1
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 1
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /backend_node/uwb_position
          Value: true
        - Alpha: 0.9
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 20
            Min Value: 0
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 245; 200
          Min Color: 40; 120; 255
          Name: Current registered scan
          Position Transformer: XYZ
          Queue Size: 1
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.029999999329447746
          Style: Points
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /localization/lio_world_cloud
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 30; 255; 105
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Lines
          Line Width: 0.07999999821186066
          Name: Optimized map trajectory
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 30; 255; 105
          Pose Style: None
          Radius: 0.029999999329447746
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /backend_node/optimized_path
          Unreliable: false
          Value: true
      Enabled: true
      Name: 02 Localization
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.7
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 20
            Min Value: 0
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 235; 80
          Min Color: 35; 80; 255
          Name: Active map (prior or runtime)
          Position Transformer: XYZ
          Queue Size: 1
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.029999999329447746
          Style: Points
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /backend_node/rviz_map
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
      Enabled: true
      Name: 03 Maps
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.85
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 135; 30
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Lines
          Line Width: 0.03999999910593033
          Name: Front-end odometry trajectory
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 135; 30
          Pose Style: None
          Radius: 0.029999999329447746
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /backend_node/odom_path
          Unreliable: false
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Accepted loop edges
          Namespaces:
            loop_edges: true
          Queue Size: 1
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 1
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /backend_node/loop_edges
          Value: true
      Enabled: true
      Name: 04 Pose Graph
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.35
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 40; 215; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 40; 215; 255
          Min Color: 40; 215; 255
          Name: Registration target submap
          Position Transformer: XYZ
          Queue Size: 1
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.03500000014901161
          Style: Points
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /backend_node/debug/target
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 65; 175
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 65; 175
          Min Color: 255; 65; 175
          Name: Aligned source scan
          Position Transformer: XYZ
          Queue Size: 1
          Selectable: false
          Size (Pixels): 3
          Size (m): 0.04500000178813934
          Style: Points
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /backend_node/debug/aligned_source
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
      Enabled: true
      Name: 05 Registration Debug
  Enabled: true
  Global Options:
    Background Color: 24; 27; 32
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 255; 200; 60
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.7853981852531433
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.7853981852531433
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: true
  Views:
    collapsed: false
  Width: 1680
  X: 80
  Y: 40
