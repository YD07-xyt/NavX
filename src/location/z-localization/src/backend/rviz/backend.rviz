              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.25
              Color: 255; 210; 80
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Head Length: 0.30000001192092896
          Head Radius: 0.10000000149011612
          Name: Body pose and covariance
          Shaft Length: 0.699999988079071
          Shaft Radius: 0.05000000074505806
          Shape: Axes
          Topic:
            Depth: 20
            Durability Policy: Volatile
            Filter size: 20
            History Policy: Keep Last
