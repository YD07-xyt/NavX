    Tree Height: 499
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.3499999940395355
          Cell Size: 1
          Class: rviz_default_plugins/Grid
          Color: 120; 125; 132
          Enabled: true
          Line Style:
            Line Width: 0.029999999329447746
            Value: Lines
          Name: Metric grid
          Normal Cell Count: 0
          Offset:
            X: 0
            Y: 0
            Z: 0
          Plane: XY
          Plane Cell Count: 80
          Reference Frame: <Fixed Frame>
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Map origin axes
          Namespaces:
            {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 1
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /backend_node/map_axes
          Value: true
        - Class: rviz_default_plugins/TF
          Enabled: true
          Frame Timeout: 15
          Frames:
            All Enabled: true
          Marker Scale: 0.5
          Name: TF tree
          Show Arrows: true
          Show Axes: false
          Show Names: false
          Tree:
            {}
          Update Interval: 0
          Value: true
      Enabled: false
      Name: 01 Environment
    - Class: rviz_common/Group
