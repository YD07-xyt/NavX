<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="main_tree">
  <!-- 主树不变 -->
  <BehaviorTree ID="main_tree">
    <Sequence>
      <IsGameStart current_game_state="{is_game_start}"/>
      <ReactiveFallback>
          <Sequence>          <!-- 回家序列，优先级最高 -->
            <IsGoHome current_projectile_allowance="{current_projectile_allowance}" 
                        min_projectile_allowance="50" 
                        current_hp="{current_hp}" 
                        min_hp="80"/>
            <Nav2Pose goal="0.0,0.0,1.0" pub_model="publisher"/>
          </Sequence>
          <Sequence>
            <IsRobotHealth current_projectile_allowance="{current_projectile_allowance}" 
                          min_projectile_allowance="50" 
                          current_hp="{current_hp}" 
                          min_hp="350"/>
            <!-- 健康情况下，执行备选任务 -->
            <ReactiveFallback>
              <SubTree ID="hit_enemy_outpost_subtree" 
                        current_enemy_outpost_hp="{current_enemy_outpost_hp}" 
                        game_time="{game_time}" 
                        use_blackboard="false"/>
              <SubTree ID="patrol_subtree" use_blackboard="true"/>
            </ReactiveFallback>
          </Sequence>
      </ReactiveFallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="hit_enemy_outpost_subtree">
      <Sequence>
          <Inverter>
              <IsEnemyOutpostDestroyed 
                  enemy_outpost_hp="{current_enemy_outpost_hp}" 
                  min_enemy_outpost_hp="40"/>
          </Inverter>
          <IsGameTimeExceeded game_time="{game_time}" threshold="300"/>
          <IsGameTimeLess game_time="{game_time}" threshold="420"/>
          <Nav2Pose goal="2.08,2.94,1.0" pub_model="publisher"/>
          <Sleep msec="2000"/>
      </Sequence>
  </BehaviorTree>

  <!-- ========== 巡逻子树（4点巡逻，每个点成功后才等待） ========== -->
  <BehaviorTree ID="patrol_subtree">
    <Repeat num_cycles="-1">
      <Sequence>
        <!-- 点1 -->
        <Timeout msec="15000">
          <Nav2Pose goal="1.47,-1.02,1.0" pub_model="publisher"/>
        </Timeout>
        <Sleep msec="2000"/>

        <!-- 点2 -->
        <Timeout msec="15000">
          <Nav2Pose goal="-0.28,1.05,1.0" pub_model="publisher"/>
        </Timeout>
        <Sleep msec="2000"/>

        <!-- 点3 -->
        <Timeout msec="15000">
          <Nav2Pose goal="0.25,-1.38,1.0" pub_model="publisher"/>
        </Timeout>
        <Sleep msec="2000"/>

        <!-- 点4 -->
        <Timeout msec="15000">
          <Nav2Pose goal="0.55,1.74,1.0" pub_model="publisher"/>
        </Timeout>
        <Sleep msec="2000"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>

  <TreeNodesModel>
    <!-- 已有节点 -->
    <Action ID="Nav2Pose">
      <input_port name="goal" type="Point"/>
    </Action>
    <Action ID="Sleep">
      <input_port name="msec" type="double"/>
    </Action>
    <Condition ID="IsGameTimeExceeded">
      <input_port name="game_time" type="int">当前游戏时间</input_port>
      <input_port name="threshold" type="int">触发阈值</input_port>
    </Condition>
    <SubTree ID="patrol_subtree"/>
    <SubTree ID="special_goal_subtree"/>
  </TreeNodesModel>
</root>